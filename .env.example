# ===== DONATION — variables de entorno =====

# --- Panel: primer administrador ---
# Se crea automáticamente la primera vez que arranca la app si no hay usuarios.
# Después, los demás usuarios se crean desde /admin/usuarios.
# En desarrollo, si no defines nada: admin@donation.local / donation2026
ADMIN_EMAIL=admin@tu-organizacion.org
ADMIN_PASSWORD=cambia-esta-clave
# ADMIN_NAME=Nombre del administrador

# Secreto para firmar las sesiones. OBLIGATORIO en producción (32+ caracteres aleatorios).
# Genera uno con: openssl rand -base64 32
# AUTH_SECRET=

# --- Base de datos ---
# - Desarrollo local: si no defines nada, se usa el archivo ./data/donation.db (SQLite).
# - Producción (Vercel): crea una base en Turso (https://turso.tech) y pega las credenciales.
# TURSO_DATABASE_URL=libsql://donation-xxxx.turso.io
# TURSO_AUTH_TOKEN=

# URL pública del sitio (para generar el enlace del formulario en el panel).
# NEXT_PUBLIC_SITE_URL=https://donation.vercel.app
